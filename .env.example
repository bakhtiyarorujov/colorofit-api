# Bu faylı .env adı ilə kopyala və YENİ açarları doldur.
# .env HEÇ VAXT commit olunmur (.gitignore-dadır).

# --- Django core ---
# Yeni açar yarat:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# Local dev üçün True, production-da False (və ya boş burax).
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=colorofit.pythonanywhere.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://colorofit.pythonanywhere.com
# DJANGO_LOG_LEVEL=INFO

# --- Database (boş olsa SQLite işlədilir) ---
# Production-da PythonAnywhere MySQL üçün doldur:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=3306

# --- Auth ---
# Google OAuth client ID (Google Cloud Console -> Credentials).
GOOGLE_OAUTH_CLIENT_ID=
# Apple Sign-In: iOS app-ın bundle ID-si (audience yoxlaması üçün).
# Bir neçə olsa vergüllə ayır: az.cuzdan.calorilens,az.cuzdan.calorilens.web
APPLE_CLIENT_IDS=az.cuzdan.calorilens

# --- External APIs ---
GEMINI_API_KEY=
SPOONACULAR_API_KEY=
CLARIFAI_PAT=
